root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# PHP (Laravel 13 backend)
[*.php]
indent_style = space
indent_size = 4

# Blade templates
[*.blade.php]
indent_style = space
indent_size = 4

# Dart (Flutter mobile)
[*.dart]
indent_style = space
indent_size = 2

# TypeScript / JavaScript (React admin)
[*.{ts,tsx,js,jsx}]
indent_style = space
indent_size = 2

# CSS / SCSS
[*.{css,scss,sass}]
indent_style = space
indent_size = 2

# HTML
[*.html]
indent_style = space
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON
[*.json]
indent_style = space
indent_size = 2

# Markdown
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Dockerfile
[Dockerfile]
indent_style = space
indent_size = 4

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 2

# Makefile
[Makefile]
indent_style = tab
indent_size = 4

# TOML (composer, cargo)
[*.toml]
indent_style = space
indent_size = 4
