# ─── Laravel ───
APP_NAME=BezaPlatform
APP_ENV=production
APP_DEBUG=false
APP_URL=https://beza-platform.com

# ─── Database ───
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=beza_platform
DB_USERNAME=beza_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# ─── Redis ───
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── Sanctum ───
SANCTUM_STATEFUL_DOMAINS=localhost,beza-platform.com
SESSION_DRIVER=cookie
SESSION_DOMAIN=.beza-platform.com

# ─── CORS ───
CORS_ALLOWED_ORIGINS=https://admin.beza-platform.com,https://wap.beza-platform.com

# ─── App Key (generate with: php artisan key:generate) ───
APP_KEY=

# ─── Frontend URLs ───
ADMIN_URL=https://admin.beza-platform.com
WAP_URL=https://wap.beza-platform.com
API_URL=https://api.beza-platform.com
