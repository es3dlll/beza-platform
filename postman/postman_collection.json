							"exec": [
								"pm.test('Remittance initiated', () => {",
								"    var json = pm.response.json();",
								"    if (json.success) {",
								"        pm.collectionVariables.set('remittance_id', json.data?.id || '');",
								"    }",
								"});"
							],
							"type": "text/javascript"
						}
					}]
				},
				{
					"name": "قائمة الحوالات",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{token}}"},
							{"key": "Accept", "value": "application/json"}
						],
						"url": {"raw": "{{base_url}}/v1/remittance", "host": ["{{base_url}}"], "path": ["v1", "remittance"]}
					}
				},
				{
					"name": "تفاصيل حوالة",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{token}}"},
