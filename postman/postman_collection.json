		},
		{
			"name": "06 — مزودو الفواتير",
			"description": "إدارة مزودي خدمة الفواتير (كهرباء، ماء، اتصالات...)",
			"item": [
				{
					"name": "قائمة المزودين",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{token}}"},
							{"key": "Accept", "value": "application/json"}
						],
						"url": {"raw": "{{base_url}}/v1/bill-providers", "host": ["{{base_url}}"], "path": ["v1", "bill-providers"]}
					}
				},
				{
					"name": "إضافة مزود",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{token}}"},
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Accept", "value": "application/json"}
						],
						"body": {"mode": "raw", "raw": "{\"name\": \"الكهرباء العامة\", \"code\": \"ELECTRIC\", \"category\": \"utility\", \"is_active\": true}"},
						"url": {"raw": "{{base_url}}/v1/bill-providers", "host": ["{{base_url}}"], "path": ["v1", "bill-providers"]}
					},
					"event": [{
						"listen": "test",
						"script": {
							"exec": [
								"pm.test('Provider created', () => {",
								"    var json = pm.response.json();",
								"    if (json.success) pm.collectionVariables.set('bill_provider_id', json.data?.id || '');",
								"});"
							],
							"type": "text/javascript"
						}
					}]
				},
				{
					"name": "تفاصيل مزود",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{token}}"},
							{"key": "Accept", "value": "application/json"}
						],
						"url": {"raw": "{{base_url}}/v1/bill-providers/{{bill_provider_id}}", "host": ["{{base_url}}"], "path": ["v1", "bill-providers", "{{bill_provider_id}}"]}
					}
				},
				{
					"name": "تحديث مزود",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Authorization", "value": "Bearer {{token}}"},
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Accept", "value": "application/json"}
						],
						"body": {"mode": "raw", "raw": "{\"name\": \"الكهرباء العامة - محدث\", \"is_active\": true}"},
						"url": {"raw": "{{base_url}}/v1/bill-providers/{{bill_provider_id}}", "host": ["{{base_url}}"], "path": ["v1", "bill-providers", "{{bill_provider_id}}"]}
					}
				},
				{
					"name": "تفعيل/تعطيل مزود",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Authorization", "value": "Bearer {{token}}"},
