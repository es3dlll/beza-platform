{
  "openapi": "3.0.3",
  "info": {
    "title": "Beza Platform API",
    "version": "1.0.0",
    "description": "Syria's Financial Operating System — 30 modules, 360+ endpoints"
  },
  "servers": [
    { "url": "https://api.beza.sy/api/v1", "description": "Production" }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": { "type": "string", "example": "963933123456" },
                  "name": { "type": "string" },
                  "device_id": { "type": "string" }
                },
                "required": ["phone"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User registered, OTP sent" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login with phone + PIN",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": { "type": "string" },
                  "pin": { "type": "string" },
                  "device_id": { "type": "string" },
                  "device_type": {
                    "type": "string",
                    "enum": ["mobile", "web"]
                  },
                  "fcm_token": { "type": "string" }
                },
                "required": ["phone", "pin"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": { "type": "object" },
                        "token": { "type": "string" },
                        "refresh_token": { "type": "string" },
                        "token_type": { "type": "string", "example": "Bearer" },
                        "expires_in": { "type": "integer" }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "message": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/otp/send": {
      "post": {
        "tags": ["Auth"],
        "summary": "Send OTP verification code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": { "type": "string" },
                  "purpose": {
                    "type": "string",
                    "enum": ["registration", "login", "pin_reset"]
                  }
                },
                "required": ["phone", "purpose"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP sent" },
          "429": { "description": "Too many requests — rate limited" }
        }
      }
    },
    "/auth/otp/verify": {
      "post": {
        "tags": ["Auth"],
        "summary": "Verify OTP code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": { "type": "string" },
                  "otp": { "type": "string" },
                  "verification_id": { "type": "string" }
                },
                "required": ["phone", "otp", "verification_id"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP verified" },
          "422": { "description": "Invalid or expired OTP" }
        }
      }
    },
    "/auth/pin/create": {
      "post": {
        "tags": ["Auth"],
        "summary": "Create transaction PIN",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": { "type": "string" },
                  "pin": { "type": "string" },
                  "pin_confirmation": { "type": "string" },
                  "verification_id": { "type": "string" }
                },
                "required": [
                  "phone",
                  "pin",
                  "pin_confirmation",
                  "verification_id"
                ]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "PIN created" },
          "422": { "description": "PINs do not match or invalid" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout and invalidate session",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logged out" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh access token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refresh_token": { "type": "string" }
                },
                "required": ["refresh_token"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Token refreshed" }
        }
      }
    },
    "/wallets": {
      "get": {
        "tags": ["Wallet"],
        "summary": "List user wallets",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "List of wallets" } }
      },
      "post": {
        "tags": ["Wallet"],
        "summary": "Create new wallet",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "currency": { "type": "string", "default": "SYP" },
                  "kyc_tier_required": { "type": "integer", "default": 1 },
                  "daily_limit": { "type": "integer", "default": 5000000 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Wallet created" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/wallets/{id}": {
      "get": {
        "tags": ["Wallet"],
        "summary": "Get wallet balance",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Wallet balance" },
          "404": { "description": "Wallet not found" }
        }
      }
    },
    "/wallets/{id}/deposit": {
      "post": {
        "tags": ["Wallet"],
        "summary": "Deposit funds to wallet",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "integer",
                    "description": "Amount in SYP minor units"
                  },
                  "currency": { "type": "string", "default": "SYP" },
                  "reference_type": { "type": "string" },
                  "reference_id": { "type": "string" },
                  "channel": { "type": "string", "default": "api" },
                  "description": { "type": "string" }
                },
                "required": ["amount"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Deposit successful" },
          "422": { "description": "Deposit failed" }
        }
      }
    },
    "/wallets/{id}/withdraw": {
      "post": {
        "tags": ["Wallet"],
        "summary": "Withdraw funds from wallet",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": { "type": "integer" },
                  "currency": { "type": "string", "default": "SYP" },
                  "reference_id": { "type": "string" },
                  "apply_fee": { "type": "boolean", "default": true },
                  "description": { "type": "string" }
                },
                "required": ["amount"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Withdrawal successful" },
          "422": { "description": "Insufficient balance or limit exceeded" }
        }
      }
    },
    "/wallets/{id}/transfer": {
      "post": {
        "tags": ["Wallet"],
        "summary": "Transfer funds between wallets",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_wallet_id": { "type": "string" },
                  "amount": { "type": "integer" },
                  "currency": { "type": "string", "default": "SYP" },
                  "apply_fee": { "type": "boolean", "default": true },
                  "description": { "type": "string" }
                },
                "required": ["to_wallet_id", "amount"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Transfer successful" },
          "422": { "description": "Insufficient balance" }
        }
      }
    },
    "/wallets/{id}/transactions": {
      "get": {
        "tags": ["Wallet"],
        "summary": "List wallet transactions",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "List of transactions" } }
      }
    },
    "/escrow": {
      "get": {
        "tags": ["Escrow"],
        "summary": "List escrow agreements",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "List of escrow agreements" } }
      },
      "post": {
        "tags": ["Escrow"],
        "summary": "Create escrow agreement",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "seller_id": { "type": "string" },
                  "amount": { "type": "integer" },
                  "reference_type": { "type": "string" },
                  "reference_id": { "type": "string" },
                  "description": { "type": "string" },
                  "fee_percent": { "type": "integer", "default": 1 }
                },
                "required": [
                  "seller_id",
                  "amount",
                  "reference_type",
                  "reference_id"
                ]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Escrow created" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/escrow/{id}": {
      "get": {
        "tags": ["Escrow"],
        "summary": "Show escrow agreement",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Escrow details" },
          "404": { "description": "Escrow not found" }
        }
      }
    },
    "/escrow/{id}/release": {
      "post": {
        "tags": ["Escrow"],
        "summary": "Release escrow funds to seller",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Funds released" },
          "422": { "description": "Already resolved or expired" }
        }
      }
    },
    "/escrow/{id}/refund": {
      "post": {
        "tags": ["Escrow"],
        "summary": "Refund escrow funds to buyer",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Funds refunded" },
          "422": { "description": "Already resolved or expired" }
        }
      }
    },
    "/escrow/{id}/dispute": {
      "post": {
        "tags": ["Escrow"],
        "summary": "Open a dispute on escrow",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": { "type": "string", "maxLength": 500 }
                },
                "required": ["reason"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Dispute opened" },
          "404": { "description": "Escrow not found" }
        }
      }
    },
    "/escrow/{id}/resolve-dispute": {
      "post": {
        "tags": ["Escrow"],
        "summary": "Resolve escrow dispute",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "resolution": { "type": "string", "maxLength": 500 },
                  "action": {
                    "type": "string",
                    "enum": ["release", "refund"],
                    "default": "release"
                  }
                },
                "required": ["resolution"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Dispute resolved" },
          "404": { "description": "Dispute not found" }
        }
      }
    },
    "/ledger/accounts": {
      "get": {
        "tags": ["Ledger"],
        "summary": "List all ledger accounts",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "List of accounts" } }
      },
      "post": {
        "tags": ["Ledger"],
        "summary": "Create ledger account",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "account_number": { "type": "string" },
                  "name": { "type": "string" },
                  "type": {
                    "type": "string",
                    "enum": [
                      "asset",
                      "liability",
                      "equity",
                      "revenue",
                      "expense"
                    ]
                  },
                  "currency": { "type": "string", "default": "SYP" },
                  "parent_id": { "type": "string" },
                  "metadata": { "type": "object" }
                },
                "required": ["account_number", "name", "type"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Account created" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/ledger/accounts/{id}/balance": {
      "get": {
        "tags": ["Ledger"],
        "summary": "Get account balance",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "Balance in minor units" } }
      }
    },
    "/ledger/journal": {
      "post": {
        "tags": ["Ledger"],
        "summary": "Post journal entry (double-entry)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reference_type": { "type": "string" },
                  "reference_id": { "type": "string" },
                  "description": { "type": "string" },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "account_id": { "type": "string" },
                        "amount": { "type": "integer" },
                        "type": {
                          "type": "string",
                          "enum": ["debit", "credit"]
                        },
                        "description": { "type": "string" }
                      }
                    }
                  }
                },
                "required": ["reference_type", "reference_id", "lines"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Journal entry posted" },
          "422": { "description": "Double entry violation" }
        }
      }
    },
    "/ledger/trial-balance": {
      "get": {
        "tags": ["Ledger"],
        "summary": "Generate trial balance report",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Trial balance data" } }
      }
    },
    "/ledger/holds": {
      "post": {
        "tags": ["Ledger"],
        "summary": "Place hold on account balance",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "account_id": { "type": "string" },
                  "amount": { "type": "integer" },
                  "reason": { "type": "string" },
                  "reference_type": { "type": "string" },
                  "reference_id": { "type": "string" },
                  "expires_at": { "type": "string", "format": "date-time" }
                },
                "required": ["account_id", "amount", "reason"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Hold placed" },
          "422": { "description": "Insufficient available balance" }
        }
      }
    },
    "/merchant/register": {
      "post": {
        "tags": ["Merchant"],
        "summary": "Register as merchant",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "business_name": { "type": "string" },
                  "business_name_ar": { "type": "string" },
                  "phone": { "type": "string" },
                  "governorate": { "type": "string" },
                  "city": { "type": "string" },
                  "commercial_registration": { "type": "string" },
                  "tax_number": { "type": "string" },
                  "category": { "type": "string" }
                },
                "required": [
                  "business_name",
                  "phone",
                  "governorate",
                  "category"
                ]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Merchant registered" },
          "422": { "description": "Validation error" }
        }
      }
    },
    "/merchant/pay": {
      "post": {
        "tags": ["Merchant"],
        "summary": "Pay merchant via QR code",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "qr_code": { "type": "string" },
                  "merchant_id": { "type": "string" },
                  "amount": { "type": "integer" },
                  "store_id": { "type": "string" }
                },
                "required": ["amount"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Payment completed" },
          "422": { "description": "Payment failed" }
        }
      }
    },
    "/cfe/transactions": {
      "post": {
        "tags": ["CoreFinancialEngine"],
        "summary": "Post a financial transaction",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reference_type": { "type": "string" },
                  "reference_id": { "type": "string" },
                  "description": { "type": "string" },
                  "channel": { "type": "string", "default": "api" },
                  "initiated_by": { "type": "string" },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "account_id": { "type": "string" },
                        "amount": { "type": "integer" },
                        "type": {
                          "type": "string",
                          "enum": ["debit", "credit"]
                        }
                      }
                    }
                  }
                },
                "required": ["reference_type", "reference_id", "lines"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Transaction posted" },
          "422": { "description": "Posting failed" }
        }
      }
    },
    "/cfe/transactions/{id}/reverse": {
      "post": {
        "tags": ["CoreFinancialEngine"],
        "summary": "Reverse a transaction",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": { "type": "string" },
                  "initiated_by": { "type": "string", "default": "system" }
                },
                "required": ["reason"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Transaction reversed" },
          "422": { "description": "Reversal failed" }
        }
      }
    },
    "/cfe/fees/calculate": {
      "post": {
        "tags": ["CoreFinancialEngine"],
        "summary": "Calculate applicable fees",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fee_type": { "type": "string" },
                  "account_id": { "type": "string" },
                  "transaction_amount": { "type": "integer" },
                  "reference_type": { "type": "string" }
                },
                "required": ["fee_type", "account_id", "transaction_amount"]
              }
            }
          }
        },
        "responses": { "200": { "description": "Fee calculation result" } }
      }
    },
    "/iam/permissions": {
      "get": {
        "tags": ["IAM"],
        "summary": "List all permissions",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "List of permissions" } }
      },
      "post": {
        "tags": ["IAM"],
        "summary": "Create permission",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "guard_name": { "type": "string", "default": "api" },
                  "module": { "type": "string" },
                  "description": { "type": "string" }
                },
                "required": ["name", "module"]
              }
            }
          }
        },
